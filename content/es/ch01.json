  "sentences": [
    { "id": "s01", "who": "narrator", "text": "Madrid es una ciudad grande. Madrid está en España.",
      "en": "Madrid is a big city. Madrid is in Spain.", "pl": "Madryt to duże miasto. Madryt jest w Hiszpanii.",
      "scene": [{ "bg": "city" }, { "show": "spain", "x": 200, "y": 40 }] },
    { "id": "s02", "who": "narrator", "text": "Esta es la casa de Lucía.",
      "en": "This is Lucía's house.", "pl": "To jest dom Lucíi.",
      "scene": [{ "bg": "home" }, { "hide": "spain" }, { "enter": "lucia", "x": 150 }] },
    { "id": "s03", "who": "narrator", "text": "Lucía tiene catorce años.",
      "en": "Lucía is fourteen.", "pl": "Lucía ma czternaście lat.",
      "scene": [{ "show": "fourteen", "over": "lucia" }] },
    { "id": "s04", "who": "narrator", "text": "Pablo es el hermano de Lucía. Pablo es pequeño.",
      "en": "Pablo is Lucía's brother. Pablo is small.", "pl": "Pablo jest bratem Lucíi. Pablo jest mały.",
      "scene": [{ "hide": "fourteen" }, { "enter": "pablo", "x": 215 }] },
    { "id": "s05", "who": "narrator", "text": "Lucía es grande, Pablo es pequeño.",
      "en": "Lucía is big, Pablo is small.", "pl": "Lucía jest duża, Pablo jest mały.",
      "scene": [{ "highlight": "lucia" }, { "highlight": "pablo", "delay": 1.4 }] },
    { "id": "s06", "who": "narrator", "text": "Carmen es la madre. Javier es el padre.",
      "en": "Carmen is the mother. Javier is the father.", "pl": "Carmen jest matką. Javier jest ojcem.",
      "scene": [{ "enter": "carmen", "x": 55 }, { "enter": "javier", "x": 280, "from": "right", "delay": 1.3 }] },
    { "id": "s07", "who": "narrator", "text": "Y Rufo es el perro de la familia.",
      "en": "And Rufo is the family dog.", "pl": "A Rufo to pies rodziny.",
      "scene": [{ "enter": "rufo", "x": 240 }, { "jump": "rufo", "delay": 0.9 }] },
    { "id": "s08", "who": "javier", "text": "¡Buenos días! ¿Tenéis hambre?",
      "en": "Good morning! Are you hungry?", "pl": "Dzień dobry! Jesteście głodni?",
      "scene": [{ "bubble": "javier", "icon": "❓" }] },
    { "id": "s09", "who": "pablo", "text": "¡Sí, mucha!",
      "en": "Yes, very!", "pl": "Tak, bardzo!",
      "scene": [{ "jump": "pablo" }, { "bubble": "pablo", "icon": "😋" }] },
    { "id": "s10", "who": "narrator", "text": "En la mesa hay pan, tomate y café.",
      "en": "On the table there is bread, tomato and coffee.", "pl": "Na stole jest chleb, pomidor i kawa.",
      "scene": [{ "show": "bread", "table": 0 }, { "show": "tomato", "table": 1, "delay": 0.8 }, { "show": "coffee", "table": 2, "delay": 1.5 }] },
    { "id": "s11", "who": "carmen", "text": "Lucía, ¿quieres un café con leche?",
      "en": "Lucía, do you want a white coffee?", "pl": "Lucía, chcesz kawę z mlekiem?",
      "scene": [{ "point": "carmen", "at": "coffee" }, { "bubble": "carmen", "icon": "❓" }] },
    { "id": "s12", "who": "lucia", "text": "No, gracias, mamá. Un zumo de naranja, por favor.",
      "en": "No, thanks, Mum. An orange juice, please.", "pl": "Nie, dziękuję, mamo. Sok pomarańczowy, proszę.",
      "scene": [{ "shake": "lucia" }, { "show": "juice", "on": "carmen", "delay": 1.2 }, { "give": "juice", "to": "lucia", "delay": 1.8 }] },
    { "id": "s13", "who": "narrator", "text": "De repente, alguien llama a la puerta.",
      "en": "Suddenly, someone knocks at the door.", "pl": "Nagle ktoś puka do drzwi.",
      "scene": [{ "knock": true }, { "bubble": "lucia", "icon": "❗", "delay": 0.6 }, { "bubble": "pablo", "icon": "❗", "delay": 0.8 }] },
    { "id": "s14", "who": "narrator", "text": "Lucía abre la puerta. No hay nadie.",
      "en": "Lucía opens the door. There is nobody.", "pl": "Lucía otwiera drzwi. Nikogo nie ma.",
      "scene": [{ "hide": "juice" }, { "move": "lucia", "x": 352 }, { "open": true, "delay": 1.2 }, { "bubble": "lucia", "icon": "🤷", "delay": 2.0 }] },
    { "id": "s15", "who": "narrator", "text": "En el suelo hay una carta.",
      "en": "On the floor there is a letter.", "pl": "Na podłodze leży list.",
      "scene": [{ "show": "letter", "floor": 375 }] },
    { "id": "s16", "who": "lucia", "text": "¿Una carta? ¿Para quién es?",
      "en": "A letter? Who is it for?", "pl": "List? Dla kogo jest?",
      "scene": [{ "give": "letter", "to": "lucia" }, { "bubble": "lucia", "icon": "❓" }] },
    { "id": "s17", "who": "pablo", "text": "¡Es para ti, Lucía! ¿De quién es?",
      "en": "It's for you, Lucía! Who is it from?", "pl": "Jest dla ciebie, Lucío! Od kogo jest?",
      "scene": [{ "move": "pablo", "x": 322 }, { "point": "pablo", "at": "lucia", "delay": 0.8 }] },
    { "id": "s18", "who": "narrator", "text": "La carta no tiene nombre. Solo dice: «El sábado, a las diez, en la Plaza Mayor».",
      "en": "The letter has no name. It only says: \"On Saturday, at ten, in the Plaza Mayor.\"", "pl": "List nie ma nazwiska. Mówi tylko: „W sobotę o dziesiątej na Plaza Mayor”.",
      "scene": [{ "show": "note", "over": "lucia" }] },
    { "id": "s19", "who": "lucia", "text": "¿Quién es? ¡Qué misterio!",
      "en": "Who is it? What a mystery!", "pl": "Kto to jest? Co za tajemnica!",
      "scene": [{ "hide": "note" }, { "bubble": "lucia", "icon": "🤔" }] }
  ],
