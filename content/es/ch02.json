  "sentences": [
    { "id": "s01", "who": "narrator", "text": "Es sábado. En Bilbao llueve un poco.",
      "en": "It is Saturday. In Bilbao it is raining a little.", "pl": "Jest sobota. W Bilbao trochę pada." },
    { "id": "s02", "who": "narrator", "text": "Ane, Iker y Txiki van a la Plaza Nueva.",
      "en": "Ane, Iker and Txiki go to the Plaza Nueva.", "pl": "Ane, Iker i Txiki idą na Plaza Nueva." },
    { "id": "s03", "who": "narrator", "text": "La plaza es bonita. Hay muchos bares.",
      "en": "The square is pretty. There are many bars.", "pl": "Plac jest ładny. Jest tu dużo barów." },
    { "id": "s04", "who": "iker", "text": "Son las once. ¿Dónde está el hombre de la carta?",
      "en": "It's eleven o'clock. Where is the man from the letter?", "pl": "Jest jedenasta. Gdzie jest ten pan od listu?" },
    { "id": "s05", "who": "ane", "text": "No sé... ¡Mira, allí!",
      "en": "I don't know... Look, over there!", "pl": "Nie wiem... Patrz, tam!" },
    { "id": "s06", "who": "narrator", "text": "Un hombre viene con un paraguas rojo.",
      "en": "A man is coming with a red umbrella.", "pl": "Idzie jakiś pan z czerwonym parasolem." },
    { "id": "s07", "who": "bruno", "text": "¡Ane! ¡Iker! ¿Cómo andan?",
      "en": "Ane! Iker! How are you doing?", "pl": "Ane! Iker! Jak leci?" },
    { "id": "s08", "who": "ane", "text": "¡Bruno! ¡Hola!",
      "en": "Bruno! Hi!", "pl": "Bruno! Cześć!" },
    { "id": "s09", "who": "narrator", "text": "Bruno es amigo de la familia. Es de Argentina y vive en Buenos Aires.",
      "en": "Bruno is a friend of the family. He is from Argentina and lives in Buenos Aires.", "pl": "Bruno jest przyjacielem rodziny. Jest z Argentyny i mieszka w Buenos Aires." },
    { "id": "s10", "who": "bruno", "text": "¡Che, qué grande que estás, Ane!",
      "en": "Hey, how big you are now, Ane!", "pl": "Ej, ale urosłaś, Ane!" },
    { "id": "s11", "who": "iker", "text": "Bruno, ¿la carta es tuya?",
      "en": "Bruno, is the letter yours?", "pl": "Bruno, to twój list?" },
    { "id": "s12", "who": "bruno", "text": "Sí, es mía. ¡Es una sorpresa!",
      "en": "Yes, it's mine. It's a surprise!", "pl": "Tak, mój. To niespodzianka!" },
    { "id": "s13", "who": "bruno", "text": "¿Tienen hambre? Vamos a comer unos pintxos.",
      "en": "Are you hungry? Let's go and eat some pintxos.", "pl": "Jesteście głodni? Chodźmy na pintxos." },
    { "id": "s14", "who": "narrator", "text": "En el bar hay pintxos de tortilla, de queso y de jamón.",
      "en": "In the bar there are pintxos with omelette, cheese and ham.", "pl": "W barze są pintxos z tortillą, z serem i z szynką." },
    { "id": "s15", "who": "bruno", "text": "Ane, ¿vos qué querés?",
      "en": "Ane, what do you want?", "pl": "Ane, co chcesz?" },
    { "id": "s16", "who": "ane", "text": "Un pintxo de tortilla, por favor.",
      "en": "An omelette pintxo, please.", "pl": "Pintxo z tortillą, proszę." },
    { "id": "s17", "who": "iker", "text": "¡Y yo uno de queso!",
      "en": "And a cheese one for me!", "pl": "A ja z serem!" },
    { "id": "s18", "who": "narrator", "text": "Y Txiki quiere agua.",
      "en": "And Txiki wants water.", "pl": "A Txiki chce wody." },
    { "id": "s19", "who": "bruno", "text": "¡Qué rico! Me encanta Bilbao.",
      "en": "How tasty! I love Bilbao.", "pl": "Pyszne! Uwielbiam Bilbao." }
  ],
