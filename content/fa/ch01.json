    "iran": "🇮🇷", "fourteen": "۱۴", "bread": "🫓", "cheese": "🧀", "tea": "🍵", "box": "📦", "key": "🔑", "note": "🕙"
  },
  "sentences": [
    { "id": "s01", "who": "narrator", "text": "تهران یه شهر بزرگه. تهران تو ایرانه.|tehrān ye šahr-e bozorge. tehrān tu irāne.",
      "en": "Tehran is a big city. Tehran is in Iran.", "pl": "Teheran to duże miasto. Teheran jest w Iranie.",
      "scene": [{ "bg": "city" }, { "show": "iran", "x": 200, "y": 40 }] },
    { "id": "s02", "who": "narrator", "text": "این خونه‌ی ساراست.|in xune-ye sārāst.",
      "en": "This is Sara's home.", "pl": "To jest dom Sary.",
      "scene": [{ "bg": "home" }, { "hide": "iran" }, { "enter": "sara", "x": 150 }] },
    { "id": "s03", "who": "narrator", "text": "سارا چهارده سالشه.|sārā cahārdah sāleše.",
      "en": "Sara is fourteen.", "pl": "Sara ma czternaście lat.",
      "scene": [{ "show": "fourteen", "over": "sara" }] },
    { "id": "s04", "who": "narrator", "text": "امیر داداش ساراست. امیر کوچیکه.|amir dādāš-e sārāst. amir kucike.",
      "en": "Amir is Sara's brother. Amir is small.", "pl": "Amir jest bratem Sary. Amir jest mały.",
      "scene": [{ "hide": "fourteen" }, { "enter": "amir", "x": 215 }] },
    { "id": "s05", "who": "narrator", "text": "سارا بزرگه، امیر کوچیکه.|sārā bozorge, amir kucike.",
      "en": "Sara is big, Amir is small.", "pl": "Sara jest duża, Amir jest mały.",
      "scene": [{ "highlight": "sara" }, { "highlight": "amir", "delay": 1.2 }] },
    { "id": "s06", "who": "narrator", "text": "مامان و بابا تو آشپزخونه‌ان.|māmān o bābā tu āšpazxune-an.",
      "en": "Mum and Dad are in the kitchen.", "pl": "Mama i tata są w kuchni.",
      "scene": [{ "enter": "maman", "x": 55 }, { "enter": "baba", "x": 280, "from": "right", "delay": 1.0 }] },
    { "id": "s07", "who": "narrator", "text": "پیشی هم گربه‌ی خونه‌ست.|piši ham gorbe-ye xune-st.",
      "en": "And Pishi is the house cat.", "pl": "A Pishi to kot domowy.",
      "scene": [{ "enter": "pishi", "x": 240 }, { "jump": "pishi", "delay": 0.9 }] },
    { "id": "s08", "who": "baba", "text": "صبح بخیر! صبحونه حاضره!|sobh bexeyr! sobhune hāzere!",
      "en": "Good morning! Breakfast is ready!", "pl": "Dzień dobry! Śniadanie gotowe!",
      "scene": [{ "bubble": "baba", "icon": "☀️" }] },
    { "id": "s09", "who": "amir", "text": "آخ جون! خیلی گشنمه!|āx jun! xeyli gošname!",
      "en": "Yay! I'm really hungry!", "pl": "Hura! Jestem bardzo głodny!",
      "scene": [{ "jump": "amir" }, { "bubble": "amir", "icon": "😋" }] },
    { "id": "s10", "who": "narrator", "text": "رو میز نون و پنیر و چایی هست.|ru miz nun o panir o cāyi hast.",
      "en": "On the table there is bread, cheese and tea.", "pl": "Na stole jest chleb, ser i herbata.",
      "scene": [{ "show": "bread", "table": 0 }, { "show": "cheese", "table": 1, "delay": 0.8 }, { "show": "tea", "table": 2, "delay": 1.5 }] },
    { "id": "s11", "who": "maman", "text": "سارا جون، چایی می‌خوای؟|sārā jun, cāyi mixāy?",
      "en": "Sara dear, do you want tea?", "pl": "Saro, kochanie, chcesz herbaty?",
      "scene": [{ "point": "maman", "at": "tea" }, { "bubble": "maman", "icon": "❓" }] },
    { "id": "s12", "who": "sara", "text": "آره، مرسی مامان.|āre, mersi māmān.",
      "en": "Yes, thanks, Mum.", "pl": "Tak, dziękuję, mamo.",
      "scene": [{ "nod": "sara" }, { "give": "tea", "to": "sara", "delay": 1.0 }] },
    { "id": "s13", "who": "narrator", "text": "یهو یه نفر زنگ درو می‌زنه.|yohu ye nafar zang-e daro mizane.",
      "en": "Suddenly someone rings the doorbell.", "pl": "Nagle ktoś dzwoni do drzwi.",
      "scene": [{ "ring": true }, { "bubble": "sara", "icon": "❗", "delay": 0.6 }, { "bubble": "amir", "icon": "❗", "delay": 0.8 }] },
    { "id": "s14", "who": "narrator", "text": "سارا درو باز می‌کنه. هیچ‌کس نیست.|sārā daro bāz mikone. hickas nist.",
      "en": "Sara opens the door. There is nobody.", "pl": "Sara otwiera drzwi. Nikogo nie ma.",
      "scene": [{ "hide": "tea" }, { "move": "sara", "x": 352 }, { "open": true, "delay": 1.0 }, { "bubble": "sara", "icon": "🤷", "delay": 1.8 }] },
    { "id": "s15", "who": "narrator", "text": "رو زمین یه جعبه‌ی کوچیک هست.|ru zamin ye ja'be-ye kucik hast.",
      "en": "On the ground there is a small box.", "pl": "Na ziemi stoi małe pudełko.",
      "scene": [{ "show": "box", "floor": 375 }] },
    { "id": "s16", "who": "sara", "text": "این چیه؟ مال کیه؟|in cie? māl-e kie?",
      "en": "What is this? Whose is it?", "pl": "Co to jest? Czyje to jest?",
      "scene": [{ "give": "box", "to": "sara" }, { "bubble": "sara", "icon": "❓" }] },
    { "id": "s17", "who": "amir", "text": "بازش کن، سارا!|bāzeš kon, sārā!",
      "en": "Open it, Sara!", "pl": "Otwórz je, Saro!",
      "scene": [{ "move": "amir", "x": 322 }, { "point": "amir", "at": "box", "delay": 0.8 }] },
    { "id": "s18", "who": "narrator", "text": "تو جعبه یه کلید قدیمیه. یه کاغذم هست: «جمعه، ساعت ده، بازار».|tu ja'be ye kelid-e qadimie. ye kāqaz-am hast: «jom'e, sā'at-e dah, bāzār».",
      "en": "In the box there is an old key. There is a piece of paper too: \"Friday, ten o'clock, the bazaar.\"", "pl": "W pudełku jest stary klucz. Jest też kartka: „Piątek, godzina dziesiąta, bazar”.",
      "scene": [{ "hide": "box" }, { "show": "key", "over": "sara" }, { "show": "note", "over": "amir", "delay": 2.2 }] },
    { "id": "s19", "who": "sara", "text": "کلید چی؟ چه عجیب!|kelid-e ci? ce ajib!",
      "en": "A key to what? How strange!", "pl": "Klucz do czego? Jakie dziwne!",
      "scene": [{ "hide": "note" }, { "bubble": "sara", "icon": "🤔" }] }
  ],
